@page
@model WebApplication1.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Înregistrare";
}

<div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
    <div class="w-50">
        <h2 class="text-center mb-4">@ViewData["Title"]</h2>

        <form method="post">
            <div class="form-group mb-3">
                <label asp-for="Input.Email" class="form-label">Adresa de email</label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Password" class="form-label">Parolă</label>
                <input asp-for="Input.Password" type="password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirmă parola</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary">Înregistrează-te</button>
            </div>
        </form>

        @section Scripts {
            <partial name="_ValidationScriptsPartial" />
        }
    </div>
</div>
